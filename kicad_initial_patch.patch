+#!/usr/bin/env python3
+# scripts/pcb_checks.py
+# Usage: run inside KiCad's python environment (pcbnew) or run with system-installed KiCad python bindings.
+import os
+try:
+    import pcbnew
+except Exception as e:
+    print("Erreur: ce script doit être lancé dans l'environnement Python de KiCad (pcbnew).")
+    raise
+
+board_path = "modem_multi_access.kicad_pcb"
+if not os.path.exists(board_path):
+    print("Fichier board non trouvé:", board_path)
+    raise SystemExit(1)
+
+board = pcbnew.LoadBoard(board_path)
+models_dir = os.path.join(os.getcwd(), "3D_models")
+print("Board loaded:", board.GetFileName())
+
+# Heuristique : attacher STEP si un fichier STEP portant le nom de la valeur du footprint existe.
+for fp in board.GetFootprints():
+    val = fp.GetValue()
+    step_name = f"{val}.step"
+    step_path = os.path.join(models_dir, step_name)
+    if os.path.exists(step_path):
+        print("STEP trouvé pour footprint", fp.GetReference(), "->", step_path)
+        # API d'attachement 3D varie selon KiCad; log uniquement pour rappel manuel.
+        # Pour attacher via script précis, utiliser FootprintEditor API ou éditer le .kicad_mod.
+
+print("Lancement DRC (via API pcbnew if available)...")
+try:
+    dra = pcbnew.DRC(board)
+    report = dra.Run()
+    print("DRC exécuté, résumé :")
+    print(report)
+except Exception as e:
+    print("Impossible d'exécuter DRC via le script (dépend de la version de KiCad).")
+    print("Vous pouvez lancer DRC manuellement dans PCBnew -> Inspect -> Design Rules Checker.")
+
+out = board_path + ".checked.kicad_pcb"
+board.Save(out)
+print("Copie du board enregistrée :", out)
+
